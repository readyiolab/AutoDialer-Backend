# Local MySQL (throwaway / laptop)
# DATABASE_URL=mysql://autodialer:autodialer@127.0.0.1:3310/autodialer

# Production RDS MySQL 8 — database name MUST be autodialer (never the loan DB)
# Keep connection_limit modest for Nest (avoid exhausting RDS); eg 10–15 per API process.
# DATABASE_URL=mysql://admin:YOUR_RDS_PASSWORD@database-1.cfgow8cw03g7.ap-south-1.rds.amazonaws.com:3306/autodialer?connection_limit=10&sslaccept=accept_invalid_certs
DATABASE_URL=mysql://autodialer:autodialer@127.0.0.1:3310/autodialer?connection_limit=10

# Local Redis
REDIS_URL=redis://127.0.0.1:6379
# Or Upstash (production) — TLS TCP for BullMQ (REST token not required):
# REDIS_HOST=glad-polliwog-98385.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true
# REDIS_URL=rediss://default:PASSWORD@glad-polliwog-98385.upstash.io:6379

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=15m
REFRESH_TOKEN_DAYS=30
PORT=3010
NODE_ENV=development

# Production:
# FRONTEND_URL=https://autodialer.lendigomicrocare.com
# CORS_ORIGINS=https://autodialer.lendigomicrocare.com
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production uploads:
# UPLOAD_DIR=/var/lib/autodialer/uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Hostinger SMTP (production sample — put real password only in server .env)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@lendigomicrocare.com
# SMTP_PASS=
# SMTP_FROM=support@lendigomicrocare.com
# EMAIL_FROM=support@lendigomicrocare.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@autodial.local
EMAIL_FROM=

WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
SMS_API_URL=https://api.smsgateway.com
SMS_API_KEY=your-sms-api-key
