# Copy to /opt/autodialer/.env on EC2 (never commit the real file).
# Fresh RDS database autodialer only — never the loan/fintech DB.
# Paste passwords on the server only.

DATABASE_URL=mysql://admin:YOUR_RDS_PASSWORD@database-1.cfgow8cw03g7.ap-south-1.rds.amazonaws.com:3306/autodialer?connection_limit=10&sslaccept=strict

# Upstash Redis (BullMQ uses TCP — not the REST token)
# Prefer either REDIS_URL=rediss://default:PASSWORD@HOST:6379
# or the discrete vars below:
REDIS_HOST=glad-polliwog-98385.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_UPSTASH_REDIS_PASSWORD
REDIS_TLS=true
# Optional REST (not used by BullMQ; safe to omit):
# UPSTASH_REDIS_REST_URL=https://glad-polliwog-98385.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

JWT_SECRET=CHANGE_ME_LONG_RANDOM_NOT_LAPTOP_SECRET
JWT_EXPIRATION=15m
REFRESH_TOKEN_DAYS=30
PORT=3010
NODE_ENV=production
FRONTEND_URL=https://autodialer.lendigomicrocare.com
CORS_ORIGINS=https://autodialer.lendigomicrocare.com
UPLOAD_DIR=/var/lib/autodialer/uploads
MAX_UPLOAD_MB=25

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@lendigomicrocare.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=support@lendigomicrocare.com
EMAIL_FROM=support@lendigomicrocare.com
